# Gemini API key — OPTIONAL. The app works fully offline without it
# (on-device OCR + the bundled item database). A key only adds the AI
# "should I take this?" verdict and sprite-only fallback identification.
#
# Local dev:  copy this file to `.env` and paste your key after the `=`.
# CI:         set a GitHub Actions repo secret named GEMINI_API_KEY; the
#             build workflow writes it into `.env` automatically.
#
# Get a key (free): https://aistudio.google.com/apikey
#
# The literal value NONE is treated by the app as "no key configured".
GEMINI_API_KEY=NONE
